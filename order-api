const mongoose = require("mongoose");

const orderSchema = new mongoose.Schema({
  items: [
    {
      product: Object,
      quantity: Number
    }
  ],
  total: Number,
  customer: {
    name: String,
    email: String,
    address: String
  },
  date: {
    type: Date,
    default: Date.now
  }
});

module.exports = mongoose.model("Order", orderSchema);
